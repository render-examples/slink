# Asked for on deploy:
ADMIN_EMAIL=you@example.com

# Set by the Blueprint: PORT, ORIGIN, ADMIN_USERNAME, ADMIN_PASSWORD (generated), TZ.
#
# Optional, add on the slink service after deploy:
# USER_ALLOW_REGISTRATION=false            # turn off public sign-ups
# USER_APPROVAL_REQUIRED=true              # default: new accounts need approval
# USER_ALLOW_UNAUTHENTICATED_ACCESS=false  # hide Explore from signed-out visitors
# IMAGE_MAX_SIZE=15M                       # largest upload
# STORAGE_PROVIDER=s3                      # store images in S3 instead of the disk
# AMAZON_S3_REGION=
# AMAZON_S3_BUCKET=
# AMAZON_S3_ACCESS_KEY_ID=
# AMAZON_S3_SECRET_ACCESS_KEY=
# Full list: https://docs.slinkapp.io/configuration/01-environment-variables/
